# === 필수 ===
PORT=4000
NODE_ENV=development

# JWT (운영에서 반드시 강한 시크릿으로 변경)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/columbarium?schema=public"

# CORS (쉼표 구분. 운영 시 웹 실제 도메인으로 설정 필수)
# 로컬: CORS_ORIGIN=http://localhost:3000,http://localhost:8081
# Railway 웹 예: CORS_ORIGIN=https://columbarium-web.up.railway.app
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# === 선택 (알림/푸시) ===
# FCM_SERVER_KEY=

# === 선택 (SMS/이메일 연동 시) ===
# SMS_API_KEY=
# EMAIL_FROM=
